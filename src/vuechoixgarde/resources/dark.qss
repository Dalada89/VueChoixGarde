QWidget {
    background-color: #2B2B2B;
    color: #F2F2F2;
    font-family: sans-serif;
    font-size: 10pt;
}
QFrame#panel, QLabel#panel {
    background-color: #383838;
    border-radius: 5px;
}
QPushButton {
    background-color: #383838;
    border: 1px solid #7A7A7A;
    border-radius: 5px;
    padding: 6px 10px;
}
QPushButton:hover { background-color: #4A4A4A; }
QPushButton:disabled { color: #B0B0B0; border-color: #686868; }
QPushButton:focus, QLineEdit:focus {
    border: 2px solid #FFFFFF;
}
QLineEdit {
    background-color: #383838;
    border: 1px solid #8A8A8A;
    border-radius: 4px;
    padding: 5px;
}
QProgressBar {
    background-color: #383838;
    border: 1px solid #777777;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk { background-color: #6FA8DC; border-radius: 3px; }
QScrollBar:vertical { background: #2B2B2B; width: 12px; }
QScrollBar::handle:vertical { background: #777777; min-height: 24px; }
